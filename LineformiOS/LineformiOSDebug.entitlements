<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<!-- Debug carries no iCloud entitlement, like the Mac's LineformDebug.entitlements: Debug
     builds always save into the on-device Documents folder and never touch the real
     iCloud container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lineform.app</string>
	</array>
</dict>
</plist>
