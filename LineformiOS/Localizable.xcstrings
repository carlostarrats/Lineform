    "When off, Files hides Lineform’s iCloud folder. New documents still save there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, blendet Dateien den iCloud-Ordner von Lineform aus. Neue Dokumente werden weiter dort gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, Archivos oculta la carpeta de iCloud de Lineform. Los documentos nuevos se siguen guardando allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, Fichiers masque le dossier iCloud de Lineform. Les nouveaux documents y sont toujours enregistrés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
