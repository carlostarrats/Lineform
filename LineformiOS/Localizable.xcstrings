    "Goes dark when your iPhone is in Dark Mode, including at night if its appearance is set to Automatic." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird dunkel, wenn dein iPhone im Dunkelmodus ist, auch nachts, wenn sein Erscheinungsbild auf „Automatisch“ steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se oscurece cuando el iPhone está en modo oscuro, también de noche si su aspecto está en Automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe en sombre quand l’iPhone est en mode sombre, y compris la nuit si son apparence est réglée sur Automatique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがダークモードのときに暗くなります。外観が「自動」なら夜間も暗くなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 处于深色模式时变暗；如果外观设为“自动”，夜间也会变暗。"
          }
        }
      }
    },
