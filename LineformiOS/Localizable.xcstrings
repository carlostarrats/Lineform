    "Ask AI…" : {
      "comment" : "Menu ▸ Document row that opens the comment field for the whole document (the Mac's Edit ▸ Ask AI… title and translations).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI fragen…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preguntar a la IA…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander à l’IA…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI に依頼…"
          }
        },
        "zh-Hans" : {
