<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Embedded into the helper binary as a __TEXT,__info_plist section (it is a bare Mach-O,
	     not a bundle, so it has nowhere else to carry this).

	     LOAD-BEARING: without a CFBundleIdentifier the sandbox has no identity to build a
	     container from, and a sandboxed helper SIGTRAPs before `main`. Verified under both
	     ad-hoc and Developer ID signing — adding this section is what makes the identical
	     binary run. -->
	<key>CFBundleIdentifier</key>
	<string>com.lineform.app.helper</string>
	<key>CFBundleName</key>
	<string>lineform</string>
	<key>CFBundleExecutable</key>
	<string>lineform</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.5.0</string>
	<key>CFBundleVersion</key>
	<string>20</string>
</dict>
</plist>
