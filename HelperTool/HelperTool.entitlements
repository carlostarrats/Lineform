<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RELEASE entitlements for the bundled `lineform` helper.

	     Every executable inside a Mac App Store bundle must be sandboxed, and this one ships
	     inside Lineform.app/Contents/Helpers.

	     There are deliberately NO file-access entitlements. The helper never reads the documents
	     it opens — it stats the path and hands the URL to LaunchServices, and the app receives
	     its own grant. Verified: a sandboxed helper can stat an arbitrary argv path, including
	     files outside any container.

	     The App Group is what makes piped stdin work. Without it the helper's write to
	     Application Support is silently redirected into its own container, where the app cannot
	     see the file. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.TV4QZT7A7X.com.lineform</string>
	</array>
</dict>
</plist>
