          }
        }
      }
    },
    "“%@” is open in another tab, so saving over it would discard that tab’s contents. Close that tab first, or choose a different name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist in einem anderen Tab geöffnet. Ein Sichern darüber würde den Inhalt dieses Tabs verwerfen. Schließe zuerst diesen Tab oder wähle einen anderen Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está abierto en otra pestaña, así que guardar encima descartaría el contenido de esa pestaña. Cierra primero esa pestaña o elige otro nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est ouvert dans un autre onglet ; l’enregistrer par-dessus supprimerait le contenu de cet onglet. Fermez d’abord cet onglet ou choisissez un autre nom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は別のタブで開いています。上書き保存すると、そのタブの内容が破棄されます。先にそのタブを閉じるか、別の名前を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在另一个标签页中打开，覆盖保存会放弃该标签页的内容。请先关闭该标签页，或选取其他名称。"
          }
        }
      }
    },
