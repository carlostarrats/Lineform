    "Inside a table, moves to the next cell. Shift-Tab goes back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt in einer Tabelle zur nächsten Zelle. Shift-Tab geht zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dentro de una tabla, va a la celda siguiente. Shift-Tab retrocede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un tableau, passe à la cellule suivante. Shift-Tab revient en arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表の中では次のセルに移動します。Shift-Tabで前に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表格中移动到下一个单元格。Shift-Tab 返回上一个。"
          }
        }
      }
    },
    "It will be moved to the Trash.": {
