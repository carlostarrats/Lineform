    "LaTeX supported: fractions, roots, Greek, sums, integrals.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX wird unterstützt: Brüche, Wurzeln, griechische Buchstaben, Summen, Integrale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible con LaTeX: fracciones, raíces, letras griegas, sumas e integrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX pris en charge : fractions, racines, grec, sommes, intégrales."
          }
        },
        "ja": {
