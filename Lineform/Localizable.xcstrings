          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separador. Al principio del archivo, --- abre el front matter en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparateur. Tout en haut du fichier, --- ouvre plutôt le front matter."
