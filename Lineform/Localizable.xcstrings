          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Claude Pro ou Max ne couvre pas cela. Anthropic facture les clés API à l’usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Claude-Pro- oder -Max-Abo deckt das nicht ab. Anthropic rechnet API-Schlüssel nach Nutzung ab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Pro や Max のサブスクリプションは対象外です。APIキーは Anthropic により従量課金されます。"
