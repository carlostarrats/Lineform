          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez le dossier à afficher dans la barre latérale Fichiers de Lineform. Vos fichiers restent à leur emplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
