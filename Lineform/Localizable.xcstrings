    "Hide Sidebar": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitenleiste ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar barra lateral"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la barre latérale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーを非表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏边栏"
          }
        }
      }
    },
    "Hides iCloud in Lineform's sidebar. Saving a new document starts outside Lineform iCloud; you can still choose iCloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet iCloud in der Seitenleiste von Lineform aus. Beim Sichern eines neuen Dokuments wird zunächst ein Ort außerhalb von Lineform iCloud gewählt; iCloud kann weiterhin gewählt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta iCloud en la barra lateral de Lineform. Al guardar un documento nuevo, se empieza fuera de iCloud de Lineform; aún puedes elegir iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque iCloud dans la barre latérale de Lineform. L’enregistrement d’un nouveau document commence hors d’iCloud Lineform ; vous pouvez toujours choisir iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LineformのサイドバーからiCloudを非表示にします。新規書類を保存するときはLineformのiCloud以外から始まりますが、iCloudを選択することもできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Lineform 的边栏中隐藏 iCloud。保存新文稿时会从 Lineform iCloud 之外的位置开始；你仍可选择 iCloud。"
          }
        }
      }
    },
    "Highlights the current line while you write.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt die aktuelle Zeile beim Schreiben hervor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resalta la línea actual mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surligne la ligne en cours pendant que vous écrivez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中に現在の行を強調表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写作时高亮标记当前行。"
          }
        }
      }
    },
