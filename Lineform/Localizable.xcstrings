    "Image. Local files show in Read and Preview; web addresses stay a placeholder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild. Lokale Dateien erscheinen in Lesen und Vorschau; Web-Adressen als Platzhalter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen. Archivos locales en Lectura y Vista previa; las web, un marcador de posición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image. Fichiers locaux affichés en Lecture et Aperçu ; adresses web, un espace réservé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像。ローカルのファイルは閲覧とプレビューで表示。Web上の画像はプレースホルダのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像。本地文件在阅读和预览中显示；网络地址仅显示占位图。"
          }
        }
      }
    },
