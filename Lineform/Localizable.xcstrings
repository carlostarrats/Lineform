    "Lineform can't find this key in your Keychain. Paste it again to reconnect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lineform can't find this key in your Keychain. Paste it again to reconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform no encuentra esta clave en tu llavero. Pégala de nuevo para volver a conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform ne trouve pas cette clé dans votre trousseau. Collez-la à nouveau pour vous reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform findet diesen Schlüssel nicht in deinem Schlüsselbund. Füge ihn erneut ein, um die Verbindung wiederherzustellen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform はキーチェーンでこのキーを見つけられません。再接続するには、もう一度ペーストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform 在你的钥匙串中找不到此密钥。请重新粘贴以重新连接。"
          }
        }
      }
    },
    "Lineform sends only the text you act on, only when you choose an AI action, directly to the provider you connected, under your account and that provider's terms. Lineform's developer receives nothing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Lineform sends only the text you act on, only when you choose an AI action, directly to the provider you connected, under your account and that provider's terms. Lineform's developer receives nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform envía solo el texto sobre el que actúas, solo cuando eliges una acción de IA, directamente al proveedor que conectaste, con tu cuenta y según las condiciones de ese proveedor. El desarrollador de Lineform no recibe nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform envoie uniquement le texte sur lequel vous agissez, uniquement lorsque vous choisissez une action d’IA, directement au fournisseur que vous avez connecté, sous votre compte et selon les conditions de ce fournisseur. Le développeur de Lineform ne reçoit rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform sendet nur den Text, mit dem du arbeitest, und nur, wenn du eine KI-Aktion wählst – direkt an den verbundenen Anbieter, unter deinem Konto und zu dessen Bedingungen. Der Entwickler von Lineform erhält nichts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform は、あなたが AI アクションを選んだときにだけ、対象のテキストだけを、接続したプロバイダへ直接送信します。送信はあなたのアカウントで、そのプロバイダの規約に従って行われます。Lineform の開発者には何も届きません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lineform 只会在你选择 AI 操作时，将你操作的文本直接发送给你连接的服务商，使用你的账户并受该服务商条款约束。Lineform 的开发者不会收到任何内容。"
          }
        }
      }
    },
    "A Claude Pro or Max subscription doesn't cover this. API keys are billed per use by Anthropic.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A Claude Pro or Max subscription doesn't cover this. API keys are billed per use by Anthropic."
          }
        },
        "es": {
          "stringUnit": {
