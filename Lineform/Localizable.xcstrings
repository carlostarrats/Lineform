    "This document uses %lld images stored outside the folders Lineform can access. Choose the folder or files to include them in the PDF, or Cancel to export without them.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses Dokument verwendet %lld Bild, das außerhalb der Ordner gespeichert ist, auf die Lineform zugreifen kann. Wähle den Ordner oder die Dateien aus, um es in das PDF aufzunehmen, oder klicke auf „Abbrechen“, um ohne es zu exportieren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses Dokument verwendet %lld Bilder, die außerhalb der Ordner gespeichert sind, auf die Lineform zugreifen kann. Wähle den Ordner oder die Dateien aus, um sie in das PDF aufzunehmen, oder klicke auf „Abbrechen“, um ohne sie zu exportieren."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This document uses %lld image stored outside the folders Lineform can access. Choose the folder or files to include it in the PDF, or Cancel to export without it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This document uses %lld images stored outside the folders Lineform can access. Choose the folder or files to include them in the PDF, or Cancel to export without them."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este documento usa %lld imagen almacenada fuera de las carpetas a las que Lineform puede acceder. Selecciona la carpeta o los archivos para incluirla en el PDF, o pulsa Cancelar para exportar sin ella."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Este documento usa %lld imágenes almacenadas fuera de las carpetas a las que Lineform puede acceder. Selecciona la carpeta o los archivos para incluirlas en el PDF, o pulsa Cancelar para exportar sin ellas."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ce document utilise %lld image stockée en dehors des dossiers auxquels Lineform a accès. Choisissez le dossier ou les fichiers pour l’inclure dans le PDF, ou cliquez sur Annuler pour exporter sans elle."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ce document utilise %lld images stockées en dehors des dossiers auxquels Lineform a accès. Choisissez le dossier ou les fichiers pour les inclure dans le PDF, ou cliquez sur Annuler pour exporter sans elles."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "この書類は、Lineformがアクセスできるフォルダの外部に保存されている画像を%lld個使用しています。それらをPDFに含めるにはフォルダまたはファイルを選択し、含めずに書き出すには「キャンセル」をクリックしてください。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "此文稿使用了 %lld 张存储在 Lineform 可访问文件夹之外的图像。请选取文件夹或文件以将它们包含在 PDF 中，或点按“取消”以在不包含它们的情况下导出。"
                }
              }
            }
          }
        }
      }
    },
    "This window has %lld tabs with unsaved changes. Closing this window will discard those changes unless you save them.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieses Fenster hat %lld Tab mit nicht gesicherten Änderungen. Beim Schließen des Fensters gehen diese Änderungen verloren, sofern du sie nicht sicherst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
