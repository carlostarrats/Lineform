    "Select the folder you want to show in Lineform's Files sidebar. Your files stay where they are.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Ordner aus, der in der Dateien-Seitenleiste von Lineform angezeigt werden soll. Deine Dateien bleiben an ihrem Speicherort."
          }
        },
        "es": {
          "stringUnit": {
