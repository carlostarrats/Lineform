    "Italic. *asterisks* work too; underscores inside a word are left alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv. *Sternchen* funktionieren auch; Unterstriche im Wort bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursiva. Los *asteriscos* también funcionan; el guion bajo dentro de una palabra, no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Italique. Les *astérisques* aussi ; les tirets bas à l’intérieur d’un mot sont ignorés."
          }
        },
        "ja": {
          "stringUnit": {
