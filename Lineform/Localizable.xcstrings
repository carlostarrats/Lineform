        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esta ventana tiene %lld pestaña con cambios sin guardar. Al cerrarla se descartarán esos cambios a menos que los guardes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Esta ventana tiene %lld pestañas con cambios sin guardar. Al cerrarla se descartarán esos cambios a menos que los guardes."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cette fenêtre contient %lld onglet comportant des modifications non enregistrées. La fermeture de cette fenêtre supprimera ces modifications si vous ne les enregistrez pas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Cette fenêtre contient %lld onglets comportant des modifications non enregistrées. La fermeture de cette fenêtre supprimera ces modifications si vous ne les enregistrez pas."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "このウインドウには、保存されていない変更があるタブが%lld個あります。ウインドウを閉じると、保存しない限りそれらの変更は破棄されます。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "此窗口有 %lld 个标签页包含未保存的更改。关闭此窗口将放弃这些更改，除非你先保存它们。"
                }
              }
