        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sangra dos espacios para anidar un elemento de la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indentez de deux espaces pour imbriquer un élément de liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペース2つ分インデントすると、リスト項目が入れ子になります。"
