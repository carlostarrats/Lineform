    "A web page — your image and link paths kept exactly as written.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Webseite – Bild- und Linkpfade bleiben exakt so, wie du sie geschrieben hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página web: las rutas de las imágenes y de los enlaces se mantienen exactamente como las escribiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page web — les chemins de vos images et de vos liens sont conservés tels quels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webページ。画像とリンクのパスは記述したままの形で保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页——图像路径和链接地址完全按照你所写的方式保留。"
          }
        }
      }
    },
