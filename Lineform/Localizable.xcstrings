    "Header row, then |---|---|, then rows. Colons align. ⌃⌘T inserts, ⌃⌘R tidies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopfzeile, |---|---|, dann Zeilen. Doppelpunkte richten aus. ⌃⌘T fügt ein, ⌃⌘R ordnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encabezado, |---|---| y filas. Los dos puntos alinean el texto. ⌃⌘T inserta, ⌃⌘R alinea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En-tête, |---|---| et lignes. Les deux-points alignent le texte. ⌃⌘T insère, ⌃⌘R aligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出し行、|---|---|、データ行の順。コロンで配置を指定。⌃⌘Tで挿入、⌃⌘Rで整形。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表头行，然后是 |---|---|，再是数据行。冒号控制对齐。⌃⌘T 插入，⌃⌘R 整理。"
          }
        }
      }
    },
