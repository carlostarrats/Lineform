    "When off, the iCloud and Workspace sections in the Files sidebar always stay expanded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option deaktiviert ist, bleiben die Bereiche „iCloud“ und „Arbeitsbereich“ in der Seitenleiste „Dateien“ immer ausgeklappt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, las secciones iCloud y Espacio de trabajo de la barra lateral Archivos permanecen siempre expandidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’option est désactivée, les sections iCloud et Espace de travail de la barre latérale Fichiers restent toujours déployées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、「ファイル」サイドバーのiCloudとワークスペースのセクションは常に展開されたままになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，“文件”边栏中的 iCloud 与工作区部分将始终保持展开。"
          }
        }
      }
    },
    "While searching, jumps to the next match; wraps around.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Springt bei der Suche zum nächsten Treffer; beginnt am Ende wieder von vorn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la búsqueda, salta a la siguiente coincidencia; al final, vuelve al principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la recherche, passe à la correspondance suivante ; à la fin, revient au début."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索中は次の該当箇所に移動します。末尾に達すると先頭に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索时跳到下一个匹配项；到末尾后回到开头。"
          }
        }
      }
    },
