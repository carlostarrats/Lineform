    "Plain http:// is only allowed for a server on this Mac. Use https:// for other addresses.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Plain http:// is only allowed for a server on this Mac. Use https:// for other addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "http:// sin cifrar solo se permite para un servidor en este Mac. Usa https:// para otras direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le http:// simple n’est autorisé que pour un serveur sur ce Mac. Utilisez https:// pour les autres adresses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsseltes http:// ist nur für einen Server auf diesem Mac erlaubt. Verwende für andere Adressen https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化されない http:// は、この Mac 上のサーバにのみ使用できます。それ以外のアドレスには https:// を使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯 http:// 仅允许用于这台 Mac 上的服务器。其他地址请使用 https://。"
          }
        }
      }
    },
    "The key wasn't accepted. Check it in Connect Your AI.": {
      "localizations": {
        "en": {
