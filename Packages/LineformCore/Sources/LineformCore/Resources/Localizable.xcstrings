    "Header row, then |---|---|, then rows. Colons align. Insert from the format row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfzeile, |---|---|, dann Zeilen. Doppelpunkte richten aus. Einfügen: Formatleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encabezado, |---|---| y filas. Los dos puntos alinean. Inserta desde la barra de formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En-tête, |---|---| et lignes. Les deux-points alignent. Insérez via la barre de format."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見出し行、|---|---|、データ行の順。コロンで配置。挿入はフォーマットバーから。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表头行，然后是 |---|---|，再是数据行。冒号控制对齐。在格式栏中插入。"
          }
        }
      }
    },
