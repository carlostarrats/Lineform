    "Divider. At the very top of a file, --- opens front matter instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennlinie. Ganz am Anfang einer Datei öffnet --- stattdessen Frontmatter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador. Al principio del archivo, --- abre el front matter en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparateur. Tout en haut du fichier, --- ouvre plutôt le front matter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区切り線。ファイルの先頭にある---はフロントマターの開始です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分隔线。若 --- 位于文件最开头，则改为开启 front matter。"
          }
        }
      }
    },
    "Fenced code block. Highlighted in Read and Preview, with a copy button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code-Block. In Lesen und Vorschau hervorgehoben, mit Button zum Kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque de código. Resaltado en Lectura y Vista previa, con botón de copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloc de code. Coloration syntaxique en Lecture et Aperçu, avec un bouton de copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードブロック。閲覧とプレビューで色分けされ、コピーボタンが付きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码块。在阅读和预览中高亮显示，并带有拷贝按钮。"
          }
        }
      }
    },
    "Fenced mermaid block renders as a diagram in Read/Preview. Write shows source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mermaid-Block wird in Lesen/Vorschau als Diagramm gezeigt, in Schreiben als Quelltext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque mermaid: diagrama en Lectura/Vista previa; en Escritura, el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloc mermaid : diagramme en Lecture/Aperçu ; en Écriture, le code source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mermaidブロックは閲覧とプレビューで図になります。執筆ではソースを表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mermaid 代码块在阅读/预览中渲染为图表；写作模式下显示源码。"
          }
        }
      }
    },
    "Header row, then |---|---|, then rows. Colons align. ⌃⌘T inserts, ⌃⌘R tidies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfzeile, |---|---|, dann Zeilen. Doppelpunkte richten aus. ⌃⌘T fügt ein, ⌃⌘R ordnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encabezado, |---|---| y filas. Los dos puntos alinean el texto. ⌃⌘T inserta, ⌃⌘R alinea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En-tête, |---|---| et lignes. Les deux-points alignent le texte. ⌃⌘T insère, ⌃⌘R aligne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見出し行、|---|---|、データ行の順。コロンで配置を指定。⌃⌘Tで挿入、⌃⌘Rで整形。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表头行，然后是 |---|---|，再是数据行。冒号控制对齐。⌃⌘T 插入，⌃⌘R 整理。"
          }
        }
      }
    },
    "Image. Local files show in Read and Preview; web addresses stay a placeholder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bild. Lokale Dateien erscheinen in Lesen und Vorschau; Web-Adressen als Platzhalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imagen. Archivos locales en Lectura y Vista previa; las web, un marcador de posición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Image. Fichiers locaux affichés en Lecture et Aperçu ; adresses web, un espace réservé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像。ローカルのファイルは閲覧とプレビューで表示。Web上の画像はプレースホルダのままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像。本地文件在阅读和预览中显示；网络地址仅显示占位图。"
          }
        }
      }
    },
    "Indent two spaces to nest a list item." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Verschachteln den Listenpunkt um zwei Leerzeichen einrücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangra dos espacios para anidar un elemento de la lista."
          }
        },
        "fr" : {
