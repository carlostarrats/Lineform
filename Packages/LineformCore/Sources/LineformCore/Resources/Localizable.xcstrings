    "Code, math, front matter, and link addresses are never flagged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code, Formeln, Frontmatter und Linkadressen werden nie markiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código, las fórmulas, el front matter y las direcciones de enlaces nunca se marcan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code, les formules, le front matter et les adresses de liens ne sont jamais signalés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード、数式、フロントマター、リンクのアドレスは対象外です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代码、公式、front matter 和链接地址不会被标记。"
          }
        }
      }
    },
