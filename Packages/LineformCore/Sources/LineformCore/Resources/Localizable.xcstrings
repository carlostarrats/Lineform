          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Sintaxis: %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Syntaxe : %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 構文：%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 语法：%2$@"
          }
        }
      }
    },
    "Adds space around blocks in Read and Preview." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt in Lesen und Vorschau Abstand um Blöcke hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade espacio alrededor de los bloques en Lectura y Vista previa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute de l’espace autour des blocs en Lecture et Aperçu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閲覧とプレビューでブロックの周囲に余白を追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在阅读和预览中为块级内容增加间距。"
          }
        }
      }
    },
    "Also math, in the form AI tools use. \\(note\\) stays text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Formeln, wie KI-Tools sie schreiben. \\(note\\) bleibt Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También fórmulas como las escriben las IA. \\(note\\) queda como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aussi des formules, comme les écrivent les outils d’IA. \\(note\\) reste du texte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIツールが書く形式の数式も表示。\\(note\\) は文字のまま。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "也支持 AI 工具写出的公式。\\(note\\) 保持为文本。"
          }
        }
      }
    },
    "Also sequence, class, ER, state, xy, and pie. Other types show their source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch sequence, class, ER, state, xy und pie. Andere Typen zeigen ihren Quelltext."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También sequence, class, ER, state, xy y pie. Los demás tipos muestran su código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Également sequence, class, ER, state, xy et pie. Les autres types affichent leur code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sequence、class、ER、state、xy、pieにも対応しています。他の種類はソースを表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还支持 sequence、class、ER、state、xy 和 pie。其他类型显示源码。"
          }
        }
      }
    },
