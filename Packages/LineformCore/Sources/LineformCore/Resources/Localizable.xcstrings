    "Divider. At the very top of a file, --- opens front matter instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennlinie. Ganz am Anfang einer Datei öffnet --- stattdessen Frontmatter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Separador. Al principio del archivo, --- abre el front matter en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séparateur. Tout en haut du fichier, --- ouvre plutôt le front matter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "区切り線。ファイルの先頭にある---はフロントマターの開始です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分隔线。若 --- 位于文件最开头，则改为开启 front matter。"
          }
        }
      }
    },
    "Fenced code block. Highlighted in Read and Preview, with a copy button." : {
