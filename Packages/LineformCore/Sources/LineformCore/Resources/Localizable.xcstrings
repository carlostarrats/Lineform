    "Inside a table, moves to the next cell. Shift-Tab goes back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Springt in einer Tabelle zur nächsten Zelle. Shift-Tab geht zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de una tabla, va a la celda siguiente. Shift-Tab retrocede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans un tableau, passe à la cellule suivante. Shift-Tab revient en arrière."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表の中では次のセルに移動します。Shift-Tabで前に戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表格中移动到下一个单元格。Shift-Tab 返回上一个。"
          }
        }
      }
    },
    "Italic. *asterisks* work too; underscores inside a word are left alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursiv. *Sternchen* funktionieren auch; Unterstriche im Wort bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursiva. Los *asteriscos* también funcionan; el guion bajo dentro de una palabra, no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Italique. Les *astérisques* aussi ; les tirets bas à l’intérieur d’un mot sont ignorés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イタリック。*アスタリスク*も使えます。単語内のアンダースコアは無視されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "斜体。也可使用 *星号*；单词内部的下划线不生效。"
          }
        }
      }
    },
    "LaTeX supported: fractions, roots, Greek, sums, integrals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LaTeX wird unterstützt: Brüche, Wurzeln, griechische Buchstaben, Summen, Integrale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible con LaTeX: fracciones, raíces, letras griegas, sumas e integrales."
