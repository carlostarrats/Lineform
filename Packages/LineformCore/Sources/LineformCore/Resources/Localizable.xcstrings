    "Code, math, front matter, and link addresses are never flagged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code, Formeln, Frontmatter und Linkadressen werden nie markiert."
          }
