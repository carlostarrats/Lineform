          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque de cita. Return la continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloc de citation. Return le continue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロック引用。Returnで継続します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "块引用。Return 继续引用。"
          }
        }
