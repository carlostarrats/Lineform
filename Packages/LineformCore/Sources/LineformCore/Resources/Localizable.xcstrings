        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粗体。"
          }
        }
      }
    },
    "Bulleted list. Return starts the next; Return on an empty one ends it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufzählung. Return beginnt den nächsten Punkt; bei leerem Punkt endet sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista con viñetas. Return inicia la siguiente; en una viñeta vacía, termina la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste à puces. Return crée la suivante ; sur une puce vide, la liste se termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "箇条書き。Returnで次の項目を追加し、空の項目でReturnを押すと終了します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "项目符号列表。Return 开始下一项；在空项上按 Return 结束列表。"
          }
        }
      }
    },
    "Callout. Also TIP, IMPORTANT, WARNING, CAUTION. Add a title after the marker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Callout. Auch TIP, IMPORTANT, WARNING, CAUTION. Titel nach dem Marker ergänzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuadro. También TIP, IMPORTANT, WARNING, CAUTION. Añade un título tras el marcador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encadré. Également TIP, IMPORTANT, WARNING, CAUTION. Ajoutez un titre après le marqueur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コールアウト。TIP、IMPORTANT、WARNING、CAUTIONも使えます。マーカーの後にタイトルを追加。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提示框。还支持 TIP、IMPORTANT、WARNING、CAUTION。可在标记后添加标题。"
          }
        }
      }
    },
