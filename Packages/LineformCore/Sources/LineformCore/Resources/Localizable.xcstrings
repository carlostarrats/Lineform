    "Lineform will send the passage you select, or the whole document when you choose Ask AI for it, to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform sendet die Passage, die du auswählst, oder das ganze Dokument, wenn du dafür „KI fragen“ wählst, an %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform will send the passage you select, or the whole document when you choose Ask AI for it, to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform enviará el pasaje que seleccionas, o el documento entero cuando eliges Preguntar a la IA para él, a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform enverra le passage que vous sélectionnez, ou le document entier si vous choisissez Demander à l’IA pour lui, à %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した部分を、文書全体に「AI に依頼」を選んだときは文書全体を、%@ に送信します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform 会将你选中的段落发送给 %@；若你对整个文稿选择“询问 AI”，则发送整个文稿。"
          }
        }
      }
    },
    "Lineform will send the passage you select, or the whole document when you choose Ask AI for it, to that address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform sendet die Passage, die du auswählst, oder das ganze Dokument, wenn du dafür „KI fragen“ wählst, an diese Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform will send the passage you select, or the whole document when you choose Ask AI for it, to that address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform enviará el pasaje que seleccionas, o el documento entero cuando eliges Preguntar a la IA para él, a esa dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lineform enverra le passage que vous sélectionnez, ou le document entier si vous choisissez Demander à l’IA pour lui, à cette adresse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した部分を、文書全体に「AI に依頼」を選んだときは文書全体を、そのアドレスに送信します。"
          }
        },
        "zh-Hans" : {
